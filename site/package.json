{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-content.mjs && vite",
    "build": "node scripts/generate-content.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist/ssr && node scripts/prerender.mjs && node scripts/prepare-sites-build.mjs && node scripts/check-build.mjs && node scripts/check-social.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/content.test.mjs tests/social-meta.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "^2.17.7",
    "vite": "6.4.2"
  }
}
